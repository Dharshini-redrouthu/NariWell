# Unit test / coverage
# -------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# -------------------------
# IDE / Editor files
# -------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# -------------------------
# OS generated files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Jupyter Notebook checkpoints
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Logs and temporary files
# -------------------------
*.log
*.tmp
*.bak

# -------------------------
# Ignore pipenv / poetry / pyenv files (optional)
# -------------------------
Pipfile.lock
.poetry/
__pypackages__/

# -------------------------
# Ignore environment files (optional)
