# -------------------------
# Python virtual environment
# -------------------------
venv/
__pycache__/
*.py[cod]
*.egg
*.egg-info/
dist/
build/
*.log

# -------------------------
# Python packaging
# -------------------------
*.whl
*.tar.gz
*.zip

